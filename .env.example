# ClinicWorks — environment variables
#
# Set these in Vercel (Project → Settings → Environment Variables), never here.
# This file lists names and shapes only; it is committed, so it holds no values.
# Endpoints that need a secret refuse every caller when it is missing rather
# than falling back to something in the repo.

# ── Login ────────────────────────────────────────────────────────────────────
# The POS roster no longer carries PINs. A device that already has staff saved
# keeps working offline; anything else is checked here.
# Either a single owner account:
MASTER_PIN=
MASTER_NAME=
# …or the full roster as a JSON map of pin -> staff:
# STAFF_PINS={"482913":{"name":"Bryan (CEO)","role":"owner","id":1},"570461":{"name":"Bank","role":"manager","id":2}}
STAFF_PINS=

# Shared key for scripts calling staff-only endpoints (?key= / x-staff-key).
STAFF_KEY=

# ── StoreHub (products, transactions, customers) ─────────────────────────────
STOREHUB_USER=
STOREHUB_KEY=

# ── AI (the 🤖 buttons, Bryan AI, receipt scanning) ──────────────────────────
# Same xAI account the storefront uses. Without this every AI feature reports
# that it is not configured.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0
ARTWORK_REFERENCE_URL=
BLOB_READ_WRITE_TOKEN=
GROK_MODEL=grok-4
GROK_VISION_MODEL=
# Only if you have a Grok Imagine video endpoint; otherwise the POS points
# staff at grok.com/imagine instead of pretending the API exists.
XAI_VIDEO_URL=
XAI_JOB_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# Extra hosts allowed to call the same-origin-guarded endpoints.
ALLOWED_ORIGIN=
# Rate limiting is backed by Upstash when set; without it limits fail open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Maps / payments, only if those POS screens are in use.
GOOGLE_MAPS_API_KEY=
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=
KBANK_MERCHANT_ID=
KBANK_API_KEY=
DUCKYPAY_API_KEY=
DUCKYPAY_CHAIN_ID=
